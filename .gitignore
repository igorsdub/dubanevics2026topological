# Local environment settings (copy from .env.example).
.env
.context/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.marimo/

# Full source inputs are stored locally and are not redistributed by this repository.
data/raw/*
!data/raw/README.md
data/interim/*
data/processed/*

# Keep generated caches and exports local, except publication PNG figures.
output/*
# The scan's acceptance record and tables are publication evidence and small, so exactly this directory is tracked.
!output/analysis/
output/analysis/*
!output/analysis/functional_threshold_scan/
output/analysis/functional_threshold_scan/.*
!output/figures/
output/figures/*
!output/figures/*.png
!output/figures/README.md
# BEGIN manuscript figures (generated by scripts/dev/sync_figure_gitignore.py)
# Edit config/manuscript.toml, then run the script; never edit this block by hand.
!output/figures/canonical/
output/figures/canonical/*

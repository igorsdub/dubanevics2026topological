# Copy to .env (ignored by Git); `just` loads it, and a variable exported in the shell wins over it.
# Folder holding counts.parquet, samples.parquet, sequences.parquet from `just export-papkou` in the barseqfit repo.
# Leave unset to use the folder `just barseq-export` writes ($BARSEQFIT, default ../barseqfit).
PAPKOU2023_BARSEQ_EXPORT=
# The Papkou et al. 2023 store (`just fetch-papkou2023` extracts into it, `just make-raw` and barseqfit read it).
PAPKOU2023RUGGED_DATA=
